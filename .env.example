# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tourmate
DB_USER=tourmate
DB_PASSWORD=<generate_secure_password>

# Test database (used by Jest integration tests)
TEST_DB_NAME=tourmate_test

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=<generate_256_bit_secret>
JWT_EXPIRES_IN=7d

# ─── Firebase ─────────────────────────────────────────────────────────────────
# Path to downloaded service account JSON from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-sa.json
# OR paste the JSON inline (for CI/CD secrets):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=<your_google_maps_api_key>

# ─── Stripe (optional — for activity booking payments) ────────────────────────
STRIPE_SECRET_KEY=<your_stripe_secret_key>
STRIPE_WEBHOOK_SECRET=<your_stripe_webhook_secret>

# ─── App Server ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Allowed CORS origin (Flutter app deep-link or web domain)
CLIENT_ORIGIN=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Storage ──────────────────────────────────────────────────────────────────
# For avatar image uploads — use local filesystem in dev, S3-compatible in prod
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=tourmate-avatars
# AWS_REGION=us-east-1

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
